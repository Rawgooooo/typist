{
  "name": "typist",
  "private": true,
  "version": "0.1.0",
  "description": "Push-to-talk dictation: hold a hotkey, speak, get text pasted at the cursor",
  "main": "electron/main.js",
  "scripts": {
    "build": "node scripts/check-syntax.js && tsc && vite build",
    "check": "node scripts/check-syntax.js",
    "start": "electron .",
    "vite": "vite",
    "package": "npm run build && electron-builder --win --arm64",
    "package:x64": "npm run build && electron-builder --win --x64",
    "package:trial": "npm run build && npm run package:trial:x64 && npm run package:trial:arm64",
    "package:trial:x64": "electron-builder --win zip --x64 --config.win.requestedExecutionLevel=asInvoker",
    "package:trial:arm64": "electron-builder --win zip --arm64 --config.win.requestedExecutionLevel=asInvoker"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  },
  "build": {
    "appId": "com.typist.app",
    "productName": "Typist",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    }
  }
}
