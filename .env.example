# Copy to `.env` and fill in your own values. `.env` is gitignored.

# Groq API key, from https://console.groq.com/keys
# Used automatically when no key has been saved in the app's settings UI.
GROQ_API_KEY=gsk_your_key_here

# Optional first-run overrides. These only apply before a config.json exists in
# %APPDATA%\com.typist.app\ — once you change settings in the UI, the saved
# config wins and these are ignored.
#
# TYPIST_HOTKEY=CommandOrControl+Shift+D
# TYPIST_ENGINE=cloud
